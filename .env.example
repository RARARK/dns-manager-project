# 네트워크 — 호스트에서 172.30.0.0/24 가 이미 쓰이고 있으면 이 블록만 바꾸면 된다.
SUBNET=172.30.0.0/24
DNS_IP=172.30.0.10
NODE1_IP=172.30.0.21
NODE2_IP=172.30.0.22
NODE3_IP=172.30.0.23

# 게시 포트를 어느 주소에 묶을지.
#   127.0.0.1 = 이 PC 안에서만 접근 가능 (권장)
#   0.0.0.0   = 같은 네트워크의 다른 PC 에서도 접근 가능
# 0.0.0.0 으로 열면 인증이 없는 관리 API 와 외부 질의를 전달하는 DNS 가
# 네트워크 전체에 노출된다(오픈 리졸버). 다른 PC 에서 시연해야 할 때만 바꾼다.
# 실험 스크립트는 도커 내부망으로 질의하므로 이 값에 영향받지 않는다.
BIND_ADDR=127.0.0.1

# 호스트 포트 — 충돌 시 이 값만 바꾼다.
# DNS_PORT 가 53 이 아닌 이유: Windows 환경에서 53/udp 가 ICS 등에 선점되는 경우가 있다.
DNS_PORT=5300
BACKEND_PORT=8080
FRONTEND_PORT=5173
NODE1_PORT=8001
NODE2_PORT=8002
NODE3_PORT=8003

# 백엔드가 허용할 브라우저 출처(CORS). 쉼표로 여러 개 지정 가능.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 다른 PC 에서 접속해 시연하려면 위 BIND_ADDR 을 0.0.0.0 으로 바꾸고
# 아래 주석을 해제한다. 접속하는 PC 의 IP 가 매번 달라 목록으로는 감당이
# 안 되므로 정규식으로 허용한다. 이 줄을 켜면 같은 네트워크의 누구나
# 인증 없는 관리 API 를 호출할 수 있게 되므로, 필요할 때만 켠다.
# CORS_ORIGIN_REGEX=http://.*:5173

# 프론트엔드가 쓸 백엔드 주소. 비워 두면 "UI 를 열고 있는 호스트:BACKEND_PORT"
# 를 자동으로 사용한다. 보통 비워 두면 된다.
VITE_BACKEND_URL=
