# CoreDNS 기동 시점에 필요한 부트스트랩 설정.
# 기동 후에는 백엔드가 DB 의 forwarding 설정을 기준으로 이 파일을 다시 생성하고,
# CoreDNS 의 reload 플러그인이 변경을 감지해 스스로 설정을 다시 읽는다.

lab.test:53 {
    file /etc/coredns/zone/db.lab.test {
        reload 2s
    }
    loadbalance round_robin
    log
    errors
}

.:53 {
    forward . 8.8.8.8 1.1.1.1
    log
    errors
    reload 5s 1s
}
